# Copy this file to .env on your production host and replace every placeholder.

POSTGRES_USER=invoiceforge
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=invoiceforge

DATABASE_URL=postgresql://invoiceforge:replace-with-a-strong-db-password@postgres:5432/invoiceforge
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=/api

# This project currently has no TypeORM migrations.
# For a brand-new database, set TYPEORM_SYNCHRONIZE=true once to create tables,
# then set it back to false before ongoing production use.
TYPEORM_SYNCHRONIZE=false
DB_SSL=false
REQUEST_BODY_LIMIT=2mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
SENSITIVE_RATE_LIMIT_MAX=20
DEMO_RATE_LIMIT_MAX=10

# Required for real client portal OTP email delivery in production.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="InvoiceForge <no-reply@your-domain.com>"

# Optional: use Twilio SendGrid API instead of SMTP.
# Use a SendGrid API key, not a regular Twilio account API key.
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM="InvoiceForge <no-reply@your-domain.com>"

# Optional: Twilio SMS for client portal OTP and password reset links.
# Keep these on the production host only; do not commit real secrets.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567
# Or use a Messaging Service instead of TWILIO_FROM_NUMBER:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_DEFAULT_COUNTRY_CODE=+91
# Optional owner forgot-password SMS target, because owner users do not store phones.
# TWILIO_OWNER_PASSWORD_RESET_TO=+919999999999

# Replace these before launch. Defaults exist for local testing only.
SUPERADMIN_EMAIL=superadmin@gmail.com
SUPERADMIN_PASSWORD=replace-with-a-strong-superadmin-password

# Optional payment gateway values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
