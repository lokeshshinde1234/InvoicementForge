# Copy these names into Railway > Service > Variables.
# Do not commit real SMTP passwords or production secrets.

NODE_ENV=production
FRONTEND_URL=https://invoicementforge.up.railway.app
API_PUBLIC_URL=https://invoicementforge.up.railway.app
NEXT_PUBLIC_SITE_URL=https://invoicementforge.up.railway.app
NEXT_PUBLIC_API_URL=/api

# Paste the content value supplied by Google Search Console.
# GOOGLE_SITE_VERIFICATION=your-google-verification-token

# Option A: individual SMTP settings.
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@your-domain.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM=InvoiceForge <your-sender@your-domain.com>
DNS_RESULT_ORDER=ipv4first

# Option B: connection string instead of host/user/pass.
# Keep SMTP_FROM set even when SMTP_URL is used.
# SMTP_URL=smtp://your-sender%40your-domain.com:your-password@smtp.your-email-provider.com:587
# SMTP_FROM=InvoiceForge <your-sender@your-domain.com>

# Option C: Resend API instead of SMTP.
# This is usually easier on Railway than SMTP host/port/TLS settings.
# Create a Resend API key and verify your sending domain in Resend.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=InvoiceForge <noreply@your-domain.com>

# Option D: Twilio SendGrid API instead of SMTP.
# Use a SendGrid API key, not a regular Twilio account API key.
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM=InvoiceForge <noreply@your-domain.com>

# Optional: Twilio SMS for client portal OTP and password reset links.
# Keep these in Railway variables only; do not commit real secrets.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567
# Or use a Messaging Service instead of TWILIO_FROM_NUMBER:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_DEFAULT_COUNTRY_CODE=+91
# Optional owner forgot-password SMS target, because owner users do not store phones.
# TWILIO_OWNER_PASSWORD_RESET_TO=+919999999999

# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASS=your-16-character-google-app-password
# SMTP_FROM=InvoiceForge <your-gmail-address@gmail.com>
